# Copy to `.env` for LOCAL development only. Never commit real values.
# On Databricks Apps these are injected by the Lakebase database resource.

PGHOST=your-instance.database.cloud.databricks.com
PGPORT=5432
PGDATABASE=databricks_postgres
PGUSER=your-user-or-service-principal
PGSSLMODE=require
PGSCHEMA=support

# Option A: mint short-lived tokens via the Databricks SDK (recommended).
#   Leave PGPASSWORD unset and provide the instance name below.
LAKEBASE_INSTANCE_NAME=your-lakebase-instance-name

# Option B: use a static password (local dev / non-Lakebase Postgres only).
# PGPASSWORD=...
